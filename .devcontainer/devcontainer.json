{
  "name": "Cross-chain bridge safety in Isabelle/HOL",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "overrideCommand": true,
  "remoteUser": "isabelle",
  "containerEnv": {
    "USER_HOME": "/home/isabelle/.bridge-benchmark",
    "BRIDGE_ISABELLE_PROFILE": "/home/isabelle/.bridge-benchmark"
  }
}
